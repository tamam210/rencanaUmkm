# Salin file ini jadi `.env`, lalu isi nilainya.
# File `.env` JANGAN dimasukkan ke Git (udah ada di .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=ganti-dengan-kunci-acak-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (harus sama dengan infra/docker-compose.yml) ---
POSTGRES_DB=sensory
POSTGRES_USER=sensory
POSTGRES_PASSWORD=sensory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (alamat frontend yang boleh nembak API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI (ISI NANTI, pas server AI udah siap) ---
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
