# Opsional. Salin file ini jadi `infra/.env` kalau mau mengganti kredensial
# database/redis. Kalau file ini tidak disalin, nilai default di bawah yang
# dipakai (aman untuk pengembangan lokal).
#
# JANGAN commit `infra/.env` (sudah diabaikan oleh .gitignore).

POSTGRES_DB=sensory
POSTGRES_USER=sensory
POSTGRES_PASSWORD=sensory
POSTGRES_PORT=5432
REDIS_PORT=6379
